            <if test="usdtBalance != null">usdt_balance = #{usdtBalance},</if>
            <if test="balanceUpdateAt != null">balance_update_at = #{balanceUpdateAt},</if>
            <if test="createAt != null">create_at = #{createAt},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="deleted != null">deleted = #{deleted},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteApikeyById" parameterType="Long">
        delete from t_apikey where id = #{id}
    </delete>

    <delete id="deleteApikeyByIds" parameterType="String">
        delete from t_apikey where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
