<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.project.business.mapper.InviteLevelMapper">

    <resultMap type="InviteLevel" id="InviteLevelResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
        <result property="inviteNum"    column="invite_num"    />
        <result property="prizeRate"    column="prize_rate"    />
        <result property="level"    column="level"    />
        <result property="status"    column="status"    />
        <result property="weight"    column="weight"    />
    </resultMap>

    <sql id="selectInviteLevelVo">
        select id, name, invite_num, prize_rate, level, status, weight from u_invite_level
    </sql>

    <sql id="SelectDomainInviteLevelVo">
        select a.id, a.name, a.invite_num, a.prize_rate, a.level, a.status, a.weight from u_invite_level a
    </sql>

    <select id="selectInviteLevelList" parameterType="InviteLevel" resultMap="InviteLevelResult">
        <include refid="selectInviteLevelVo"/>
        <where>
            <if test="status != null "> and status = #{status}</if>
            <if test="weight != null "> and weight = #{weight}</if>
        </where>
    </select>

    <select id="selectInviteLevelById" parameterType="Long" resultMap="InviteLevelResult">
        <include refid="selectInviteLevelVo"/>
        where id = #{id}
    </select>

    <insert id="insertInviteLevel" parameterType="InviteLevel" useGeneratedKeys="true" keyProperty="id">
        insert into u_invite_level
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null">name,</if>
            <if test="inviteNum != null">invite_num,</if>
            <if test="prizeRate != null">prize_rate,</if>
            <if test="level != null">level,</if>
            <if test="status != null">status,</if>
            <if test="weight != null">weight,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null">#{name},</if>
            <if test="inviteNum != null">#{inviteNum},</if>
            <if test="prizeRate != null">#{prizeRate},</if>
            <if test="level != null">#{level},</if>
            <if test="status != null">#{status},</if>
            <if test="weight != null">#{weight},</if>
         </trim>
    </insert>

    <update id="updateInviteLevel" parameterType="InviteLevel">
        update u_invite_level
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null">name = #{name},</if>
            <if test="inviteNum != null">invite_num = #{inviteNum},</if>
            <if test="prizeRate != null">prize_rate = #{prizeRate},</if>
            <if test="level != null">level = #{level},</if>
            <if test="status != null">status = #{status},</if>
            <if test="weight != null">weight = #{weight},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteInviteLevelById" parameterType="Long">
        delete from u_invite_level where id = #{id}
    </delete>

    <delete id="deleteInviteLevelByIds" parameterType="String">
        delete from u_invite_level where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
