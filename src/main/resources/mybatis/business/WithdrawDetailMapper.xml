<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.project.business.mapper.WithdrawDetailMapper">

    <resultMap type="WithdrawDetail" id="WithdrawDetailResult">
        <result property="id"    column="id"    />
        <result property="flowId"    column="flow_id"    />
        <result property="uid"    column="uid"    />
        <result property="addressId"    column="address_id"    />
        <result property="amount"    column="amount"    />
        <result property="fromAddr"    column="from_addr"    />
        <result property="toAddr"    column="to_addr"    />
        <result property="status"    column="status"    />
        <result property="hash"    column="hash"    />
        <result property="sendAt"    column="send_at"    />
        <result property="confirmAt"    column="confirm_at"    />
        <result property="confirmBlockNo"    column="confirm_block_no"    />
        <result property="memo"    column="memo"    />
        <result property="seq"    column="seq"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="deleted"    column="deleted"    />
        <result property="addr"    column="addr"    />
        <result property="pid"    column="pid"    />
    </resultMap>

    <sql id="selectWithdrawDetailVo">
        select id, flow_id, uid, address_id, amount, from_addr, to_addr, status, hash, send_at, confirm_at, confirm_block_no, memo, seq, create_time, update_time, deleted from a_withdraw_detail
    </sql>

    <sql id="SelectDomainVo">
        select a.id,  a.flow_id,  a.uid,  a.address_id,  a.amount,  a.from_addr,  a.to_addr,  a.status,  a.hash,  a.send_at,  a.confirm_at,  a.confirm_block_no,  a.memo,  a.seq,  a.create_time,  a.update_time,  a.deleted,  l.account, b.pid from a_withdraw_detail a left join u_login l on l.uid = a.uid and l.type = 1
    </sql>

    <select id="selectWithdrawDetailList" parameterType="WithdrawDetail" resultMap="WithdrawDetailResult">
        <include refid="SelectDomainVo"/>, u_member b
        <where>
            and a.uid = b.id
            and b.deleted = 0
            <if test="addr !=null "> and b.addr = #{addr} </if>
            <if test="flowId != null "> and a.flow_id = #{flowId}</if>
            <if test="uid != null "> and a.uid = #{uid}</if>
            <if test="toAddr != null  and toAddr != ''"> and a.to_addr = #{toAddr}</if>
            <if test="status != null "> and a.status = #{status}</if>
            <if test="hash != null  and hash != ''"> and a.hash = #{hash}</if>
        </where>
        order by a.id
    </select>

    <select id="selectWithdrawDetailById" parameterType="Long" resultMap="WithdrawDetailResult">
        <include refid="selectWithdrawDetailVo"/>
        where id = #{id}
    </select>

    <insert id="insertWithdrawDetail" parameterType="WithdrawDetail" useGeneratedKeys="true" keyProperty="id">
        insert into a_withdraw_detail
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="flowId != null">flow_id,</if>
            <if test="uid != null">uid,</if>
            <if test="addressId != null">address_id,</if>
            <if test="amount != null">amount,</if>
            <if test="fromAddr != null">from_addr,</if>
            <if test="toAddr != null">to_addr,</if>
            <if test="status != null">status,</if>
            <if test="hash != null">hash,</if>
            <if test="sendAt != null">send_at,</if>
            <if test="confirmAt != null">confirm_at,</if>
            <if test="confirmBlockNo != null">confirm_block_no,</if>
            <if test="memo != null">memo,</if>
            <if test="seq != null">seq,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="deleted != null">deleted,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="flowId != null">#{flowId},</if>
            <if test="uid != null">#{uid},</if>
            <if test="addressId != null">#{addressId},</if>
            <if test="amount != null">#{amount},</if>
            <if test="fromAddr != null">#{fromAddr},</if>
            <if test="toAddr != null">#{toAddr},</if>
            <if test="status != null">#{status},</if>
            <if test="hash != null">#{hash},</if>
            <if test="sendAt != null">#{sendAt},</if>
            <if test="confirmAt != null">#{confirmAt},</if>
            <if test="confirmBlockNo != null">#{confirmBlockNo},</if>
            <if test="memo != null">#{memo},</if>
            <if test="seq != null">#{seq},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="deleted != null">#{deleted},</if>
         </trim>
    </insert>

    <update id="updateWithdrawDetail" parameterType="WithdrawDetail">
        update a_withdraw_detail
        <trim prefix="SET" suffixOverrides=",">
            <if test="flowId != null">flow_id = #{flowId},</if>
            <if test="uid != null">uid = #{uid},</if>
            <if test="addressId != null">address_id = #{addressId},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="fromAddr != null">from_addr = #{fromAddr},</if>
            <if test="toAddr != null">to_addr = #{toAddr},</if>
            <if test="status != null">status = #{status},</if>
            <if test="hash != null">hash = #{hash},</if>
            <if test="sendAt != null">send_at = #{sendAt},</if>
            <if test="confirmAt != null">confirm_at = #{confirmAt},</if>
            <if test="confirmBlockNo != null">confirm_block_no = #{confirmBlockNo},</if>
            <if test="memo != null">memo = #{memo},</if>
            <if test="seq != null">seq = #{seq},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="deleted != null">deleted = #{deleted},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteWithdrawDetailById" parameterType="Long">
        delete from a_withdraw_detail where id = #{id}
    </delete>

    <delete id="deleteWithdrawDetailByIds" parameterType="String">
        delete from a_withdraw_detail where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="listWithChildren" resultMap="WithdrawDetailResult">
        <include refid="SelectDomainVo"/>, (
        WITH RECURSIVE cte AS (
        select 0 as n, u.* from u_member u <if test="account != null  and account != ''">join u_login ul on u.id = ul.uid and ul.type in (3)</if>
        <where>
            <if test="uid != null "> and u.id = #{uid}</if>
            <if test="account != null  and account != ''"> and ul.account = #{account,jdbcType=VARCHAR}</if>
            <if test="pid != null "> and u.pid = #{pid}</if>
            and u.deleted = 0
        </where>
        union all
        select  n+1,e.* from u_member e inner join `cte` c on e.pid = c.id and e.deleted = 0
        ) select distinct id, addr, pid, n from `cte`
        ) b
        <where>
            <if test="flowId != null "> and a.flow_id = #{flowId}</if>
            and a.uid = b.id
            <if test="toAddr != null  and toAddr != ''"> and a.to_addr = #{toAddr}</if>
            <if test="status != null "> and a.status = #{status}</if>
            <if test="hash != null  and hash != ''"> and a.hash = #{hash}</if>
            and a.deleted = 0
        </where>
        order by b.n, b.id
    </select>

    <select id="listWithParents" resultMap="WithdrawDetailResult">
        <include refid="SelectDomainVo"/>, (
        WITH RECURSIVE cte AS (
        select 0 as n, u.* from u_member u <if test="account != null  and account != ''">join u_login ul on u.id = ul.uid and ul.type in (3)</if>
        <where>
            <if test="uid != null "> and u.id = #{uid}</if>
            <if test="account != null  and account != ''"> and ul.account = #{account,jdbcType=VARCHAR}</if>
            <if test="pid != null "> and u.pid = #{pid}</if>
            and u.deleted = 0
        </where>
        union all
        select  n+1,e.* from u_member e inner join `cte` c on c.pid = e.id and e.deleted = 0
        ) select distinct id, addr, pid, n from `cte`
        ) b
        <where>
            and a.uid = b.id
            <if test="flowId != null "> and a.flow_id = #{flowId}</if>
            <if test="toAddr != null  and toAddr != ''"> and a.to_addr = #{toAddr}</if>
            <if test="status != null "> and a.status = #{status}</if>
            <if test="hash != null  and hash != ''"> and a.hash = #{hash}</if>
            and a.deleted = 0
        </where>
        order by b.n, b.id
    </select>

    <select id="listAll" resultMap="WithdrawDetailResult" parameterType="String">
        <include refid="selectWithdrawDetailVo"/> where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>
</mapper>
