<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.project.business.mapper.ConfigMapper">

    <resultMap type="com.ruoyi.project.business.domain.Config" id="ConfigResult">
        <result property="id"    column="id"    />
        <result property="category"    column="category"    />
        <result property="configKey"    column="config_key"    />
        <result property="configName"    column="config_name"    />
        <result property="configValue"    column="config_value"    />
        <result property="rule"    column="rule"    />
        <result property="memo"    column="memo"    />
        <result property="status"    column="status"    />
        <result property="weight"    column="weight"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="deleted"    column="deleted"    />
    </resultMap>

    <sql id="selectConfigVo">
        select id, category, config_key, config_name, config_value, rule, memo, status, weight, create_time, update_time, deleted from s_config
    </sql>

    <sql id="SelectDomainConfigVo">
        select a.id, a.category, a.config_key, a.config_name, a.config_value, a.rule, a.memo, a.status, a.weight, a.create_time, a.update_time, a.deleted from s_config a
    </sql>

    <select id="selectConfigList" parameterType="Config" resultMap="ConfigResult">
        <include refid="selectConfigVo"/>
        <where>
            <if test="category != null  and category != ''"> and category like concat('%', #{category}, '%')</if>
            <if test="configKey != null  and configKey != ''"> and config_key like concat('%', #{configKey}, '%')</if>
            <if test="configName != null  and configName != ''"> and config_name like concat('%', #{configName}, '%')</if>
            <if test="status != null "> and status = #{status}</if>
            and deleted = 0
        </where>

    </select>

    <select id="selectConfigById" parameterType="Long" resultMap="ConfigResult">
        <include refid="selectConfigVo"/>
        where id = #{id}
    </select>

    <insert id="insertConfig" parameterType="Config" useGeneratedKeys="true" keyProperty="id">
        insert into s_config
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="category != null and category != ''">category,</if>
            <if test="configKey != null and configKey != ''">config_key,</if>
            <if test="configName != null">config_name,</if>
            <if test="configValue != null">config_value,</if>
            <if test="rule != null">rule,</if>
            <if test="memo != null">memo,</if>
            <if test="status != null">status,</if>
            <if test="weight != null">weight,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="category != null and category != ''">#{category},</if>
            <if test="configKey != null and configKey != ''">#{configKey},</if>
            <if test="configName != null">#{configName},</if>
            <if test="configValue != null">#{configValue},</if>
            <if test="rule != null">#{rule},</if>
            <if test="memo != null">#{memo},</if>
            <if test="status != null">#{status},</if>
            <if test="weight != null">#{weight},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateConfig" parameterType="Config">
        update s_config
        <trim prefix="SET" suffixOverrides=",">
            <if test="category != null and category != ''">category = #{category},</if>
            <if test="configKey != null and configKey != ''">config_key = #{configKey},</if>
            <if test="configName != null">config_name = #{configName},</if>
            <if test="configValue != null">config_value = #{configValue},</if>
            <if test="rule != null">rule = #{rule},</if>
            <if test="memo != null">memo = #{memo},</if>
            <if test="status != null">status = #{status},</if>
            <if test="weight != null">weight = #{weight},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteConfigById" parameterType="Long">
        update s_config set deleted  = id where id = #{id}
    </delete>

    <delete id="deleteConfigByIds" parameterType="String">
        update s_config set deleted  = id where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
