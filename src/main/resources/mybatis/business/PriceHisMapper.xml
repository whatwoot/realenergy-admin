<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.project.business.mapper.PriceHisMapper">

    <resultMap type="PriceHis" id="PriceHisResult">
        <result property="id"    column="id"    />
        <result property="symbol"    column="symbol"    />
        <result property="price"    column="price"    />
        <result property="period"    column="period"    />
        <result property="updateAt"    column="update_at"    />
        <result property="createTime"    column="create_time"    />
        <result property="price0CumulativeLast"    column="price0_cumulative_last"    />
        <result property="price1CumulativeLast"    column="price1_cumulative_last"    />
        <result property="blockTimestampLast"    column="block_timestamp_last"    />
        <result property="createAt"    column="create_at"    />
    </resultMap>

    <sql id="selectPriceHisVo">
        select id, symbol, price, period, update_at, create_time, price0_cumulative_last, price1_cumulative_last, block_timestamp_last, create_at from c_price_his
    </sql>

    <sql id="SelectDomainPriceHisVo">
        select a.id, a.symbol, a.price, a.period, a.update_at, a.create_time, a.price0_cumulative_last, a.price1_cumulative_last, a.block_timestamp_last, a.create_at from c_price_his a
    </sql>

    <select id="selectPriceHisList" parameterType="PriceHis" resultMap="PriceHisResult">
        <include refid="selectPriceHisVo"/>
        <where>
            <if test="symbol != null  and symbol != ''"> and symbol = #{symbol}</if>
            <if test="price != null "> and price = #{price}</if>
            <if test="period != null "> and period = #{period}</if>
            <if test="updateAt != null "> and update_at = #{updateAt}</if>
            <if test="price0CumulativeLast != null "> and price0_cumulative_last = #{price0CumulativeLast}</if>
            <if test="price1CumulativeLast != null "> and price1_cumulative_last = #{price1CumulativeLast}</if>
            <if test="blockTimestampLast != null "> and block_timestamp_last = #{blockTimestampLast}</if>
            <if test="createAt != null "> and create_at = #{createAt}</if>
        </where>
    </select>

    <select id="selectPriceHisById" parameterType="Long" resultMap="PriceHisResult">
        <include refid="selectPriceHisVo"/>
        where id = #{id}
    </select>

    <insert id="insertPriceHis" parameterType="PriceHis" useGeneratedKeys="true" keyProperty="id">
        insert into c_price_his
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="symbol != null">symbol,</if>
            <if test="price != null">price,</if>
            <if test="period != null">period,</if>
            <if test="updateAt != null">update_at,</if>
            <if test="createTime != null">create_time,</if>
            <if test="price0CumulativeLast != null">price0_cumulative_last,</if>
            <if test="price1CumulativeLast != null">price1_cumulative_last,</if>
            <if test="blockTimestampLast != null">block_timestamp_last,</if>
            <if test="createAt != null">create_at,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="symbol != null">#{symbol},</if>
            <if test="price != null">#{price},</if>
            <if test="period != null">#{period},</if>
            <if test="updateAt != null">#{updateAt},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="price0CumulativeLast != null">#{price0CumulativeLast},</if>
            <if test="price1CumulativeLast != null">#{price1CumulativeLast},</if>
            <if test="blockTimestampLast != null">#{blockTimestampLast},</if>
            <if test="createAt != null">#{createAt},</if>
         </trim>
    </insert>

    <update id="updatePriceHis" parameterType="PriceHis">
        update c_price_his
        <trim prefix="SET" suffixOverrides=",">
            <if test="symbol != null">symbol = #{symbol},</if>
            <if test="price != null">price = #{price},</if>
            <if test="period != null">period = #{period},</if>
            <if test="updateAt != null">update_at = #{updateAt},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="price0CumulativeLast != null">price0_cumulative_last = #{price0CumulativeLast},</if>
            <if test="price1CumulativeLast != null">price1_cumulative_last = #{price1CumulativeLast},</if>
            <if test="blockTimestampLast != null">block_timestamp_last = #{blockTimestampLast},</if>
            <if test="createAt != null">create_at = #{createAt},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deletePriceHisById" parameterType="Long">
        delete from c_price_his where id = #{id}
    </delete>

    <delete id="deletePriceHisByIds" parameterType="String">
        delete from c_price_his where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
