<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.project.business.mapper.BannerMapper">

    <resultMap type="Banner" id="BannerResult">
        <result property="id"    column="id"    />
        <result property="pos"    column="pos"    />
        <result property="type"    column="type"    />
        <result property="title"    column="title"    />
        <result property="titleZhTw"    column="title_zh_tw"    />
        <result property="titleEnUs"    column="title_en_us"    />
        <result property="titleKoKr"    column="title_ko_kr"    />
        <result property="content"    column="content"    />
        <result property="contentZhTw"    column="content_zh_tw"    />
        <result property="contentEnUs"    column="content_en_us"    />
        <result property="contentKoKr"    column="content_ko_kr"    />
        <result property="thumbUrl"    column="thumb_url"    />
        <result property="imageUrl"    column="image_url"    />
        <result property="imageUrlZhTw"    column="image_url_zh_tw"    />
        <result property="imageUrlEnUs"    column="image_url_en_us"    />
        <result property="imageUrlKoKr"    column="image_url_ko_kr"    />
        <result property="jumpUrl"    column="jump_url"    />
        <result property="status"    column="status"    />
        <result property="validAt"    column="valid_at"    />
