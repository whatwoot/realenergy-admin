    </resultMap>

    <sql id="selectBannerVo">
        select id, pos, type, title, title_zh_tw, title_en_us, title_ko_kr, content, content_zh_tw, content_en_us, content_ko_kr, thumb_url, image_url, image_url_zh_tw, image_url_en_us, image_url_ko_kr, jump_url, status, valid_at, invalid_at, start_at, end_at, weight, memo, create_time, update_time, deleted from s_banner
    </sql>

    <sql id="SelectDomainBannerVo">
        select a.id, a.pos, a.type, a.title, a.title_zh_tw, a.title_en_us, a.title_ko_kr, a.content, a.content_zh_tw, a.content_en_us, a.content_ko_kr, a.thumb_url, a.image_url, a.image_url_zh_tw, a.image_url_en_us, a.image_url_ko_kr, a.jump_url, a.status, a.valid_at, a.invalid_at, a.start_at, a.end_at, a.weight, a.memo, a.create_time, a.update_time, a.deleted from s_banner a
    </sql>

    <select id="selectBannerList" parameterType="Banner" resultMap="BannerResult">
        <include refid="selectBannerVo"/>
        <where>
            <if test="pos != null  and pos != ''"> and pos = #{pos}</if>
            <if test="type != null "> and type = #{type}</if>
            <if test="title != null  and title != ''"> and title = #{title}</if>
            <if test="titleZhTw != null  and titleZhTw != ''"> and title_zh_tw = #{titleZhTw}</if>
            <if test="titleEnUs != null  and titleEnUs != ''"> and title_en_us = #{titleEnUs}</if>
            <if test="titleKoKr != null  and titleKoKr != ''"> and title_ko_kr = #{titleKoKr}</if>
            <if test="content != null  and content != ''"> and content = #{content}</if>
            <if test="contentZhTw != null  and contentZhTw != ''"> and content_zh_tw = #{contentZhTw}</if>
            <if test="contentEnUs != null  and contentEnUs != ''"> and content_en_us = #{contentEnUs}</if>
            <if test="contentKoKr != null  and contentKoKr != ''"> and content_ko_kr = #{contentKoKr}</if>
            <if test="thumbUrl != null  and thumbUrl != ''"> and thumb_url = #{thumbUrl}</if>
            <if test="imageUrl != null  and imageUrl != ''"> and image_url = #{imageUrl}</if>
            <if test="imageUrlZhTw != null  and imageUrlZhTw != ''"> and image_url_zh_tw = #{imageUrlZhTw}</if>
            <if test="imageUrlEnUs != null  and imageUrlEnUs != ''"> and image_url_en_us = #{imageUrlEnUs}</if>
            <if test="imageUrlKoKr != null  and imageUrlKoKr != ''"> and image_url_ko_kr = #{imageUrlKoKr}</if>
            <if test="jumpUrl != null  and jumpUrl != ''"> and jump_url = #{jumpUrl}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="validAt != null "> and valid_at = #{validAt}</if>
            <if test="invalidAt != null "> and invalid_at = #{invalidAt}</if>
            <if test="startAt != null "> and start_at = #{startAt}</if>
            <if test="endAt != null "> and end_at = #{endAt}</if>
            <if test="weight != null "> and weight = #{weight}</if>
            <if test="memo != null  and memo != ''"> and memo = #{memo}</if>
        </where>
    </select>

    <select id="selectBannerById" parameterType="Long" resultMap="BannerResult">
        <include refid="selectBannerVo"/>
        where id = #{id}
    </select>

    <insert id="insertBanner" parameterType="Banner" useGeneratedKeys="true" keyProperty="id">
        insert into s_banner
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="pos != null">pos,</if>
            <if test="type != null">type,</if>
            <if test="title != null">title,</if>
            <if test="titleZhTw != null">title_zh_tw,</if>
            <if test="titleEnUs != null">title_en_us,</if>
            <if test="titleKoKr != null">title_ko_kr,</if>
            <if test="content != null">content,</if>
            <if test="contentZhTw != null">content_zh_tw,</if>
            <if test="contentEnUs != null">content_en_us,</if>
            <if test="contentKoKr != null">content_ko_kr,</if>
            <if test="thumbUrl != null">thumb_url,</if>
            <if test="imageUrl != null">image_url,</if>
            <if test="imageUrlZhTw != null">image_url_zh_tw,</if>
            <if test="imageUrlEnUs != null">image_url_en_us,</if>
            <if test="imageUrlKoKr != null">image_url_ko_kr,</if>
            <if test="jumpUrl != null">jump_url,</if>
            <if test="status != null">status,</if>
            valid_at,
            invalid_at,
            start_at,
            end_at,
            <if test="weight != null">weight,</if>
            <if test="memo != null">memo,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="deleted != null">deleted,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="pos != null">#{pos},</if>
            <if test="type != null">#{type},</if>
            <if test="title != null">#{title},</if>
            <if test="titleZhTw != null">#{titleZhTw},</if>
            <if test="titleEnUs != null">#{titleEnUs},</if>
            <if test="titleKoKr != null">#{titleKoKr},</if>
            <if test="content != null">#{content},</if>
            <if test="contentZhTw != null">#{contentZhTw},</if>
            <if test="contentEnUs != null">#{contentEnUs},</if>
            <if test="contentKoKr != null">#{contentKoKr},</if>
            <if test="thumbUrl != null">#{thumbUrl},</if>
            <if test="imageUrl != null">#{imageUrl},</if>
            <if test="imageUrlZhTw != null">#{imageUrlZhTw},</if>
            <if test="imageUrlEnUs != null">#{imageUrlEnUs},</if>
            <if test="imageUrlKoKr != null">#{imageUrlKoKr},</if>
            <if test="jumpUrl != null">#{jumpUrl},</if>
            <if test="status != null">#{status},</if>
            #{validAt},
            #{invalidAt},
            #{startAt},
            #{endAt},
            <if test="weight != null">#{weight},</if>
            <if test="memo != null">#{memo},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="deleted != null">#{deleted},</if>
         </trim>
    </insert>

    <update id="updateBanner" parameterType="Banner">
        update s_banner
        <trim prefix="SET" suffixOverrides=",">
            <if test="pos != null">pos = #{pos},</if>
            <if test="type != null">type = #{type},</if>
            <if test="title != null">title = #{title},</if>
            <if test="titleZhTw != null">title_zh_tw = #{titleZhTw},</if>
            <if test="titleEnUs != null">title_en_us = #{titleEnUs},</if>
            <if test="titleKoKr != null">title_ko_kr = #{titleKoKr},</if>
            <if test="content != null">content = #{content},</if>
            <if test="contentZhTw != null">content_zh_tw = #{contentZhTw},</if>
            <if test="contentEnUs != null">content_en_us = #{contentEnUs},</if>
            <if test="contentKoKr != null">content_ko_kr = #{contentKoKr},</if>
            <if test="thumbUrl != null">thumb_url = #{thumbUrl},</if>
            <if test="imageUrl != null">image_url = #{imageUrl},</if>
            <if test="imageUrlZhTw != null">image_url_zh_tw = #{imageUrlZhTw},</if>
            <if test="imageUrlEnUs != null">image_url_en_us = #{imageUrlEnUs},</if>
            <if test="imageUrlKoKr != null">image_url_ko_kr = #{imageUrlKoKr},</if>
            <if test="jumpUrl != null">jump_url = #{jumpUrl},</if>
            <if test="status != null">status = #{status},</if>
