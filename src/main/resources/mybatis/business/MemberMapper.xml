    <sql id="SelectDomainMemberVo">
        select a.id, a.pid, a.main_account, a.nickname, a.photo_url, a.valid, a.valid_at, a.reg_source, a.level_id, a.invite_level_id,
               a.can_withdraw,a.can_pay, a.invite_code, a.invite_num, a.status, a.reg_at, a.country_code, a.country, a.full_name,
