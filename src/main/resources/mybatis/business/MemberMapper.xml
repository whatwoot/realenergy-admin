    </select>

    <update id="updateNoLoop" parameterType="Member">
        WITH RECURSIVE InviteTree AS (
        SELECT id, pid
        FROM u_member
        WHERE id = #{pid} and deleted = 0
        UNION ALL
        SELECT u.id, u.pid
        FROM u_member u INNER JOIN InviteTree it ON u.id = it.pid and u.deleted = 0
        )
        update u_member
        <set>
            pid = #{pid},
        </set>
        where id = #{id}
        and pid is null
        and not exists (
        SELECT 1 FROM InviteTree WHERE id = #{id}
        )
    </update>

    <select id="countLoop" resultType="int">
        WITH RECURSIVE InviteTree AS (
            SELECT id, pid
            FROM u_member
            WHERE id = #{id} and deleted = 0
            UNION ALL
            SELECT u.id, u.pid
            FROM u_member u INNER JOIN InviteTree it ON u.id = it.pid and u.deleted = 0
            where u.id != #{id}
        )
        select count(*) from InviteTree
        where pid = #{id}
    </select>

