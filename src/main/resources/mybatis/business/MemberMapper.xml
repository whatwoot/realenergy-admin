    <select id="listWithChildren" resultMap="BaseResult">
        WITH RECURSIVE cte AS (
        select 0 as n, u.* from u_member u <if test="mainAccount != null  and mainAccount != ''">join u_login ul on u.id = ul.uid and ul.type in (3)</if>
        <where>
            <if test="id != null "> and u.id = #{id}</if>
            <if test="mainAccount != null and mainAccount != ''"> and ul.account = #{mainAccount,jdbcType=VARCHAR}</if>
            <if test="pid != null "> and u.pid = #{pid}</if>
            and u.deleted = 0
        </where>
        union all
        select n+1,e.* from u_member e inner join `cte` c on e.pid = c.id where e.deleted = 0
        ) select *, l.account from `cte` a left join u_login l on a.id = l.uid and l.type = 3
        <where>
            <if test="genesis != null ">
                and a.genesis = #{genesis}
            </if>
            <if test="inviteCode != null  and inviteCode != ''">
                and a.invite_code = #{inviteCode}
            </if>
            <if test="levelId != null ">
                and a.level_id = #{levelId}
            </if>
            <if test="status != null ">
                and a.`status` = #{status}
            </if>
            <if test="valid != null ">
                and a.valid = #{valid}
            </if>
            <if test="canWithdraw != null ">
                and a.can_withdraw = #{canWithdraw}
            </if>
            <if test="memo != null ">
                and a.memo = #{memo}
            </if>

            <if test="params.beginRegAt != null and params.beginRegAt != '' and params.endRegAt != null and params.endRegAt != ''"> and a.reg_at between #{params.beginRegAt} and #{params.endRegAt}</if>
        </where>
        order by a.n
    </select>

