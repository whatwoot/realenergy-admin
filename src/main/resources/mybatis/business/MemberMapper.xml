    <select id="selectList" parameterType="Member" resultMap="BaseResult">
        <include refid="SelectDomainMemberVo"/>
        <where>
            <if test="id != null">
                and a.id = #{id}
            </if>
            <if test="mainAccount != null  and mainAccount != ''">
                and l.account like concat('%',#{mainAccount},'%')
            </if>
            <if test="pid != null "> and a.pid = #{pid}</if>
            <if test="genesis != null "> and a.genesis = #{genesis}</if>
            <if test="levelId != null "> and a.level_id = #{levelId}</if>
            <if test="inviteCode != null  and inviteCode != ''"> and a.invite_code = #{inviteCode}</if>
            <if test="status != null "> and a.`status` = #{status}</if>
            <if test="valid != null "> and a.valid = #{valid}</if>
            <if test="params.beginRegAt != null and params.beginRegAt != '' and params.endRegAt != null and params.endRegAt != ''"> and a.reg_at between #{params.beginRegAt} and #{params.endRegAt}</if>
            <if test="canWithdraw != null "> and a.can_withdraw = #{canWithdraw}</if>
            and a.deleted = 0
        </where>
        order by a.id desc
    </select>

    <select id="selectById" parameterType="Long" resultMap="BaseResult">
