<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.project.business.mapper.MerchantMapper">

    <resultMap type="Merchant" id="MerchantResult">
        <result property="id"    column="id"    />
        <result property="uid"    column="uid"    />
        <result property="pid"    column="pid"    />
        <result property="name"    column="name"    />
        <result property="code"    column="code"    />
        <result property="curated"    column="curated"    />
        <result property="photoUrl"    column="photo_url"    />
        <result property="businessType"    column="business_type"    />
        <result property="legalName"    column="legal_name"    />
        <result property="licenseNum"    column="license_num"    />
        <result property="licenseUrl"    column="license_url"    />
        <result property="contact"    column="contact"    />
        <result property="countryCode"    column="country_code"    />
        <result property="province"    column="province"    />
        <result property="city"    column="city"    />
        <result property="district"    column="district"    />
        <result property="address"    column="address"    />
        <result property="lon"    column="lon"    />
        <result property="lat"    column="lat"    />
        <result property="status"    column="status"    />
        <result property="autoWithdraw"    column="auto_withdraw"    />
        <result property="secretKey"    column="secret_key"    />
        <result property="qrIndex"    column="qr_index"    />
        <result property="createAt"    column="create_at"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="deleted"    column="deleted"    />
        <result property="addr"    column="addr"    />
        <result property="account"    column="account"    />
        <result property="pid"    column="pid"    />
    </resultMap>

    <sql id="selectMerchantVo">
        select id, uid, pid, name,curated,photo_url,business_type, code, legal_name, license_num, license_url, contact, country_code, province, city, district, address, lon, lat, status, auto_withdraw, secret_key, qr_index, create_at, create_time, update_time, deleted from p_merchant
    </sql>

    <sql id="SelectDomainVo">
        select a.id,  a.uid,  a.pid,a.curated,a.photo_url,a.business_type,  a.name,  a.code,  a.legal_name,  a.license_num,  a.license_url,  a.contact,  a.country_code,  a.province,  a.city,  a.district,  a.address,  a.lon,  a.lat,  a.status,  a.auto_withdraw,  a.secret_key,  a.qr_index,  a.create_at,  a.create_time,  a.update_time,  a.deleted,  l.account, b.pid from p_merchant a left join u_login l on a.uid = l.uid and l.type in (3)
    </sql>

    <select id="selectMerchantList" parameterType="Merchant" resultMap="MerchantResult">
        <include refid="SelectDomainVo"/>, u_member b
        <where>
            and a.uid = b.id
            and b.deleted = 0
            <if test="account != null and account != ''"> and l.account like concat('%',#{account},'%')</if>
            <if test="uid != null "> and a.uid = #{uid}</if>
            <if test="name != null  and name != ''"> and a.name like concat('%', #{name}, '%')</if>
            <if test="code != null  and code != ''"> and a.code = #{code}</if>
            <if test="legalName != null  and legalName != ''"> and a.legal_name like concat('%', #{legalName}, '%')</if>
            <if test="status != null "> and a.status = #{status}</if>
        </where>
        order by a.id desc
    </select>

    <select id="selectMerchantById" parameterType="Long" resultMap="MerchantResult">
        <include refid="selectMerchantVo"/>
        where id = #{id}
    </select>

    <insert id="insertMerchant" parameterType="Merchant" useGeneratedKeys="true" keyProperty="id">
        insert into p_merchant
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="uid != null">uid,</if>
            <if test="pid != null">pid,</if>
            <if test="name != null">name,</if>
            <if test="code != null">code,</if>
            <if test="legalName != null">legal_name,</if>
            <if test="licenseNum != null">license_num,</if>
            <if test="licenseUrl != null">license_url,</if>
            <if test="contact != null">contact,</if>
            <if test="countryCode != null">country_code,</if>
            <if test="province != null">province,</if>
            <if test="city != null">city,</if>
            <if test="district != null">district,</if>
            <if test="address != null">address,</if>
            <if test="lon != null">lon,</if>
            <if test="lat != null">lat,</if>
            <if test="status != null">status,</if>

            <if test="curated != null">curated,</if>
            <if test="photoUrl != null">photo_url,</if>
            <if test="businessType != null">business_type,</if>
            <if test="autoWithdraw != null">auto_withdraw,</if>
            <if test="secretKey != null">secret_key,</if>
            <if test="qrIndex != null">qr_index,</if>
            <if test="createAt != null">create_at,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="deleted != null">deleted,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="uid != null">#{uid},</if>
            <if test="pid != null">#{pid},</if>
            <if test="name != null">#{name},</if>
            <if test="code != null">#{code},</if>
            <if test="legalName != null">#{legalName},</if>
            <if test="licenseNum != null">#{licenseNum},</if>
            <if test="licenseUrl != null">#{licenseUrl},</if>
            <if test="contact != null">#{contact},</if>
            <if test="countryCode != null">#{countryCode},</if>
            <if test="province != null">#{province},</if>
            <if test="city != null">#{city},</if>
            <if test="district != null">#{district},</if>
            <if test="address != null">#{address},</if>
            <if test="lon != null">#{lon},</if>
            <if test="lat != null">#{lat},</if>
            <if test="status != null">#{status},</if>
            <if test="curated != null">#{curated},</if>
            <if test="photoUrl != null">#{photoUrl},</if>
            <if test="businessType != null">#{businessType},</if>
            <if test="autoWithdraw != null">#{autoWithdraw},</if>
            <if test="secretKey != null">#{secretKey},</if>
            <if test="qrIndex != null">#{qrIndex},</if>
            <if test="createAt != null">#{createAt},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="deleted != null">#{deleted},</if>
         </trim>
    </insert>

    <update id="updateMerchant" parameterType="Merchant">
        update p_merchant
        <trim prefix="SET" suffixOverrides=",">
            <if test="uid != null">uid = #{uid},</if>
            <if test="pid != null">pid = #{pid},</if>
            <if test="name != null">name = #{name},</if>
            <if test="code != null">code = #{code},</if>
            <if test="legalName != null">legal_name = #{legalName},</if>
            <if test="licenseNum != null">license_num = #{licenseNum},</if>
            <if test="licenseUrl != null">license_url = #{licenseUrl},</if>
            <if test="contact != null">contact = #{contact},</if>
            <if test="countryCode != null">country_code = #{countryCode},</if>
            <if test="province != null">province = #{province},</if>
            <if test="city != null">city = #{city},</if>
            <if test="district != null">district = #{district},</if>
            <if test="address != null">address = #{address},</if>
            <if test="lon != null">lon = #{lon},</if>
            <if test="lat != null">lat = #{lat},</if>
            <if test="status != null">status = #{status},</if>

            <if test="curated != null">status = #{curated},</if>
            <if test="photoUrl != null">photo_url = #{photoUrl},</if>
            <if test="businessType != null">business_type = #{businessType},</if>
            <if test="autoWithdraw != null">auto_withdraw = #{autoWithdraw},</if>
            <if test="secretKey != null">secret_key = #{secretKey},</if>
            <if test="qrIndex != null">qr_index = #{qrIndex},</if>
            <if test="createAt != null">create_at = #{createAt},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="deleted != null">deleted = #{deleted},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteMerchantById" parameterType="Long">
        delete from p_merchant where id = #{id}
    </delete>

    <delete id="deleteMerchantByIds" parameterType="String">
        delete from p_merchant where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="listWithChildren" resultMap="MerchantResult">
        <include refid="SelectDomainVo"/>, (
        WITH RECURSIVE cte AS (
        select 0 as n, u.* from u_member u <if test="account != null  and account != ''"> join u_login ul on u.id = ul.uid and ul.type in (3) </if>
        <where>
            and u.deleted = 0
            <if test="uid != null "> and u.id = #{uid}</if>
            <if test="account != null  and account != ''"> and ul.account  = #{account} </if>
            <if test="pid != null "> and u.pid = #{pid}</if>
        </where>
        union all
        select  n+1,e.* from u_member e inner join `cte` c on e.pid = c.id and e.deleted = 0
        ) select distinct id, pid, n from `cte`
        ) b
        <where>
            and a.uid = b.id
            <if test="name != null  and name != ''"> and a.name like concat('%', #{name}, '%')</if>
            <if test="code != null  and code != ''"> and a.code = #{code}</if>
            <if test="legalName != null  and legalName != ''"> and a.legal_name like concat('%', #{legalName}, '%')</if>
            <if test="status != null "> and a.status = #{status}</if>
            and a.deleted = 0
        </where>
        order by b.n, b.id
    </select>

    <select id="listWithParents" resultMap="MerchantResult">
        <include refid="SelectDomainVo"/>, (
        WITH RECURSIVE cte AS (
        select 0 as n, u.* from u_member u <if test="account != null  and account != ''">join u_login ul on u.id = ul.uid and ul.type in (3)</if>
        <where>
            and u.deleted = 0
            <if test="uid != null "> and u.id = #{uid}</if>
            <if test="account != null  and account != ''"> and ul.account  = #{account} </if>
            <if test="pid != null "> and u.pid = #{pid}</if>
        </where>
        union all
        select  n+1,e.* from u_member e inner join `cte` c on c.pid = e.id
        ) select distinct id, pid, n from `cte`
        ) b
        <where>
            and a.uid = b.id
            <if test="name != null  and name != ''"> and a.name like concat('%', #{name}, '%')</if>
            <if test="code != null  and code != ''"> and a.code = #{code}</if>
            <if test="legalName != null  and legalName != ''"> and a.legal_name like concat('%', #{legalName}, '%')</if>
            <if test="status != null "> and a.status = #{status}</if>
            and a.deleted = 0
        </where>
        order by b.n, b.id
    </select>

    <update id="updateBatch">
        update p_merchant
        <set>
            <if test="e.curated != null">
                curated = #{e.curated},
            </if>
            <if test="e.photoUrl != null and e.photoUrl != ''">
                photo_url = #{e.photoUrl},
            </if>
            <if test="e.businessType != null and e.businessType != ''">
                business_type = #{e.businessType},
            </if>
        </set>
        where id in
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
</mapper>
