    <sql id="selectNoticeVo">
        select notice_id, notice_title,
               notice_title_en_us,
               notice_title_zh_tw,
               notice_title_zh_cn,
               notice_title_ko_kr,
               notice_title_ru_ru,
               notice_title_ja_jp,
               notice_title_de_de,
               notice_title_es_es,
               notice_title_vi_vn,
               notice_title_ar_sa,
               notice_type,
               cover_url,
               cover_url_en_us,
               cover_url_zh_tw,
               cover_url_zh_cn,
               cover_url_ko_kr,
               cover_url_ru_ru,
