               notice_content_en_us,
               notice_content_zh_tw,
               notice_content_zh_cn,
               notice_content_ko_kr,
               notice_content_ru_ru,
               notice_content_ja_jp,
               notice_content_de_de,
               notice_content_es_es,
               notice_content_vi_vn,
               notice_content_ar_sa,
               status, create_by, create_time, update_by, update_time, remark
		from sys_notice
    </sql>

    <select id="selectNoticeById" parameterType="Long" resultMap="SysNoticeResult">
        <include refid="selectNoticeVo"/>
        where notice_id = #{noticeId}
    </select>

    <select id="selectNoticeList" parameterType="SysNotice" resultMap="SysNoticeResult">
        <include refid="selectNoticeVo"/>
        <where>
			<if test="noticeTitle != null and noticeTitle != ''">
				AND (
                notice_title like concat('%', #{noticeTitle}, '%')
                or notice_title_en_us like concat('%', #{noticeTitle}, '%')
                or notice_title_zh_tw like concat('%', #{noticeTitle}, '%')
                )
			</if>
			<if test="noticeType != null and noticeType != ''">
				AND notice_type = #{noticeType}
			</if>
			<if test="createBy != null and createBy != ''">
				AND create_by like concat('%', #{createBy}, '%')
			</if>
		</where>
        order by notice_id desc
    </select>

